<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!-- micrometer-registry-prometheus is a client library, not the Prometheus server -->
    <suppress>
        <notes>False positive: CPE maps Micrometer Prometheus registry to Prometheus server</notes>
        <packageUrl regex="true">^pkg:maven/io\.micrometer/micrometer-registry-prometheus@.*$</packageUrl>
        <cpe>cpe:/a:prometheus:prometheus</cpe>
    </suppress>
    <!-- angus-activation is not Angus Mail -->
    <suppress>
        <notes>False positive: CPE maps Eclipse Angus Activation to Angus Mail</notes>
        <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/angus-activation@.*$</packageUrl>
        <cpe>cpe:/a:eclipse:angus_mail</cpe>
    </suppress>
</suppressions>
