# Copy to .env for local overrides: cp .env.example .env
# Docker Compose loads `.env` automatically for ${VAR} substitution.

# --- Host ports ---
POSTGRES_PORT=5432
MONGO_PORT=27017
APP_PORT=8080

# --- PostgreSQL ---
POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments

# --- MongoDB ---
MONGO_DB=payments_audit
MONGO_URI=mongodb://mongo:27017/payments_audit
# Spring Boot 4 binds Mongo via spring.mongodb.uri (SPRING_MONGODB_URI). Compose sets both
# SPRING_MONGODB_URI and SPRING_DATA_MONGODB_URI from MONGO_URI.
# Required on Docker Desktop / Linux kernel 6.19+ (Mongo SERVER-121912)
MONGO_GLIBC_TUNABLES=glibc.pthread.rseq=1

# --- Redis (optional query cache — Phase 8) ---
# Enable with: docker compose --profile redis up --build -d
# and set PAYMENT_CACHE_USER_ENABLED=true
REDIS_PORT=6379
PAYMENT_CACHE_USER_ENABLED=false
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# --- Webhooks (optional Phase 10) ---
# Enable and run a host listener on :9999 (see README "Webhook demo").
# Compose maps host.docker.internal → host gateway for container → host POSTs.
PAYMENT_WEBHOOKS_ENABLED=false

# --- Security (OWASP Dependency-Check) ---
# Get a free key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
